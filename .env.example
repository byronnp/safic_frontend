# SAFIC · Frontend. Copia este archivo como .env (no se sube a git).
# Estas variables solo las usa el servidor de desarrollo: no llegan al navegador.

# Backend al que se reenvían las llamadas /api/v1.
#   Con Docker (red "safic"):  http://api:8080
#   Sin Docker (npm run dev):  http://localhost:8000
API_PROXY_TARGET=http://api:8080

# true si el código está en una carpeta de Windows: detecta los cambios por sondeo.
# En WSL o Linux puede ir en false.
SAFIC_WATCH_POLLING=true
